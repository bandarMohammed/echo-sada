# ECHO environment variables — names only. Copy to .env and fill real values.
# NEVER commit .env. Secrets are provided locally and via Vercel env settings.

# --- Runtime ---
NODE_ENV=development

# --- Database (Neon serverless Postgres) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection used by Prisma migrations.
DIRECT_URL=

# --- AI provider ---
# "mock" runs the deterministic offline adapter (no key needed).
# "openai" uses the OpenAI adapter and requires OPENAI_API_KEY.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- App behavior ---
DEMO_MODE=true
APP_DEFAULT_LOCALE=ar
